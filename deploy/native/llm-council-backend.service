[Unit]
Description=LLM Council backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/data/projects/llm-council
EnvironmentFile=/data/projects/llm-council/.env
Environment=BACKEND_HOST=127.0.0.1
Environment=BACKEND_PORT=8001
ExecStart=/usr/bin/env uv run python -m backend.main
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target


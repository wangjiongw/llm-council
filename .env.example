# Optional initial LLM provider defaults.
# You can leave these blank and configure the provider from the frontend settings UI.
OPENAI_API_KEY=
OPENAI_API_BASE_URL=

# Native deployment ports.
APP_PORT=18080
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001

# Optional proxy settings.
# uv sync and the backend process inherit these when set.
# npm install/build does not use proxy by default because some cluster proxies
# break npm registry downloads; set NPM_USE_PROXY=1 to let npm inherit them.
NPM_USE_PROXY=0
BACKEND_USE_PROXY=1
# HTTP_PROXY=http://proxy.example:port
# HTTPS_PROXY=http://proxy.example:port
# NO_PROXY=localhost,127.0.0.1
